{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/main",
    "outDir": "dist/main"
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist"]
}
